  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6f6e68" } },
    { "scope": ["keyword", "storage", "constant.numeric"], "settings": { "foreground": "#74556f" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#18756f" } },
    { "scope": ["string", "entity.name.type"], "settings": { "foreground": "#141413" } },
    { "scope": "invalid", "settings": { "foreground": "#7f2c28" } }
  ]
