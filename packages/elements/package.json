{
  "name": "@teal-ink/elements",
  "version": "0.1.1",
  "type": "module",
  "description": "Use Teal Ink Web Components in plain HTML and any JavaScript framework",
  "keywords": [
    "web-components",
    "custom-elements",
    "html",
    "theme",
    "design-system",
    "naive-ui",
    "teal-ink"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sn0wo2/teal-ink-design.git",
    "directory": "packages/elements"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register.js",
    "./dist/register.global.js",
    "./dist/register-full.js",
    "./dist/register-full.global.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./register.global.js": "./dist/register.global.js",
    "./full": {
      "types": "./dist/full.d.ts",
      "import": "./dist/full.js"
    },
    "./register-full": {
      "types": "./dist/register-full.d.ts",
      "import": "./dist/register-full.js"
    },
    "./register-full.global.js": "./dist/register-full.global.js"
  },
  "scripts": {
    "build": "vite build && vite build --mode global && vite build --mode global-full && vue-tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@teal-ink/vue": "0.1.1",
    "@vueuse/core": "^15.0.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "vite": "8.3.6"
  }
}
