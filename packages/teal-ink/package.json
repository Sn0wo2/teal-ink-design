{
  "name": "@teal-ink/vue",
  "version": "0.1.0",
  "type": "module",
  "description": "Teal Ink theme and Vue components, built on Naive UI",
  "files": ["dist", "src"],
  "sideEffects": ["**/*.css", "**/*.scss"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "teal-ink-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "default": "./dist/style.css"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "naive-ui": "2.45.3"
  }
}
