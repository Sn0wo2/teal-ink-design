{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "customConditions": ["teal-ink-source"]
  },
  "vueCompilerOptions": {
    "checkUnknownComponents": true
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.vue",
    "examples/**/*.ts",
    "examples/**/*.vue"
  ]
}
